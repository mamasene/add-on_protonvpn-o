# -*- coding: utf-8 -*-
"""
SCons build script for the NVDA ProtonVPN Accessibility add-on.

Delegates to the tools/ scripts that build_simple.ps1 also calls, so both entry
points produce the same package. Build logic belongs in tools/, not here.

Usage:
    scons           - Build the .nvda-addon package
    scons -c        - Clean build artifacts
"""

import os
import sys

# Prevent bytecode from being written
sys.dont_write_bytecode = True

from SCons.Script import AlwaysBuild, Command, Default, Depends, Dir, Clean, Alias

# SConstruct is executed without __file__; '#' is the project root for SCons.
REPO_ROOT = Dir('#').abspath
sys.path.insert(0, os.path.join(REPO_ROOT, "tools"))
sys.path.insert(0, REPO_ROOT)

import buildVars
import compile_po
import generate_manifest
import generate_translated_manifests
import package

ADDON_DIR = "addon"
MANIFEST = os.path.join(ADDON_DIR, "manifest.ini")

addon_name = buildVars.addon_info["addon_name"]
addon_version = buildVars.addon_info["addon_version"]
addon_filename = f"{addon_name}-{addon_version}.nvda-addon"


def build_manifest(target, source, env):
    generate_manifest.generate(str(source[0]), str(target[0]))
    return 0


def build_locales(target, source, env):
    compile_po.compile_all(ADDON_DIR)
    # Store metadata per language, read from the catalogs just compiled.
    generate_translated_manifests.generate_all()
    return 0


def build_package(target, source, env):
    package.build(str(target[0]))
    return 0


# The documentation under addon/doc/ is committed, curated HTML.
# It is never generated from readme.md: doing so would destroy the formatting.

manifest = Command(MANIFEST, "manifest.ini.tpl", build_manifest)
Depends(manifest, "buildVars.py")

locales = Command(
    os.path.join(ADDON_DIR, "locale", "fr", "LC_MESSAGES", "nvda.mo"),
    os.path.join(ADDON_DIR, "locale", "fr", "LC_MESSAGES", "nvda.po"),
    build_locales,
)

addon = Command(addon_filename, [], build_package)
Depends(addon, manifest)
Depends(addon, locales)
# Repackage every run: the inputs live under addon/, which SCons does not scan.
AlwaysBuild(addon)
Default(addon)

Clean(addon, [addon_filename, MANIFEST, ".sconsign.dblite"])

Alias("build", addon)
Alias("manifest", manifest)

print(f"""
=== NVDA Add-on Build Configuration ===
Add-on Name: {addon_name}
Version: {addon_version}
Output: {addon_filename}
=====================================
""")
